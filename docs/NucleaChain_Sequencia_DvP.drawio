xt;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#1A7D70;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1462.5" y="1325" width="317" height="31" /></mxCell><mxCell id="e62" style="edgeStyle=none;endArrow=block;endFill=1;strokeColor=#8064A3;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1330" y="1470" /><mxPoint as="targetPoint" x="190" y="1470" /></mxGeometry></mxCell><mxCell id="n63" value="" style="rounded=1;arcSize=10;fillColor=#F5F7FB;strokeColor=#F5F7FB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="376.0" y="1433" width="768" height="29" /></mxCell><mxCell id="n64" value="DvPExecuted(tradeId, basketId, buyer, holder, price) • Núclea e BEE4" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#8064A3;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="382.0" y="1435" width="768" height="31" /></mxCell><mxCell id="n65" value="" style="rounded=1;arcSize=10;fillColor=#FFF3E2;strokeColor=#DFBD82;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="1640" width="1990" height="133" /></mxCell><mxCell id="n66" value="Nenhum ativo fica custodiado em contrato: CCBs e BRLN sempre aparecem nas carteiras do holder e do comprador." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#72552C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="1658" width="1950" height="31" /></mxCell><mxCell id="n67" value="Se qualquer perna falhar (saldo, congelamento do BRLN, CCB vencida, prazo), executeDvP reverte inteira e nada se move. Antes de executar, a Núclea pode consultar canExecute(tradeId)." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#72552C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="1689" width="1950" height="31" /></mxCell><mxCell id="n68" value="Contínua = transação; roxa tracejada = evento lido após confirmação. Cancelamento: cancelTrade (Núclea/BEE4, ou qualquer conta após o prazo)." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=DejaVu Sans;fontSize=21;fontColor=#72552C;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="1720" width="1950" height="31" /></mxCell></root></mxGraphModel></diagram></mxfile>
